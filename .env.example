# Copie este arquivo para .env.local e preencha com os valores do SEU
# projeto Supabase (Project Settings → API no painel supabase.com).
# NUNCA coloque a service_role key aqui — só a URL e a anon/public key, que
# são seguras pra expor no cliente porque toda a proteção real vem do RLS
# (Row Level Security) configurado nas migrations, não do sigilo da chave.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
